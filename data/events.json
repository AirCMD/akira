    "generation": {
      "enabled": true,

      "checkIntervalMinutes": 5,

      "maximumSimultaneousEvents": 3,

      "probabilityModifiers": {
        "time": true,
        "weather": true,
        "location": true,
        "needs": true,
        "emotions": true,
        "personality": true,
        "interests": true,
        "preferences": true,
        "relationships": true,
        "memories": true,
        "goals": true,
        "recentEvents": true
      },

      "rules": {
        "eventsAreNotGuaranteed": true,
        "sameEventCanHaveDifferentEffects": true,
        "characterStateCanChangeEventOutcome": true,
        "eventCanBeIgnored": true,
        "eventCanBeMissed": true,
        "eventCanInterruptCurrentAction": true,
        "eventCanBePostponed": true,
        "eventsCanChainTogether": true,
        "eventsCanCreateNewEvents": true,
        "eventsCanModifyExistingEvents": true,
        "eventsCanModifyGoals": true,
        "eventsCanModifyNeeds": true,
        "eventsCanModifyEmotions": true,
        "eventsCanModifyRelationships": true,
        "eventsCanCreateMemories": true,
        "eventsCanChangeWorld": true
      }
    },

    "chains": {
      "enabled": true,

      "rules": {
        "eventCanTriggerEvent": true,
        "triggerChanceCanDependOnOutcome": true,
        "chainCanStopNaturally": true,
        "chainCanBeInterrupted": true
      },

      "examples": [
        {
          "start": "customerArrives",
          "next": [
            "difficultCustomerQuestion",
            "successfulSale",
            "customerNeedsHelp"
          ]
        },
