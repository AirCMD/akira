            "replyToYani",
            "planMeeting",
            "rememberYani"
          ]
        }
      ]
    },

    "consequences": {
      "enabled": true,

      "dimensions": [
        "needs",
        "emotions",
        "goals",
        "relationships",
        "knowledge",
        "skills",
        "memories",
        "world",
        "currentAction",
        "futureOpportunities"
      ],

      "rules": {
        "consequencesCanBeImmediate": true,
        "consequencesCanBeDelayed": true,
        "consequencesCanBeTemporary": true,
        "consequencesCanBePermanent": true,
        "consequencesCanAccumulate": true,
        "smallEventsCanHaveSmallConsequences": true,
        "majorEventsCanHaveMultipleConsequences": true
      }
    },

    "history": {
      "enabled": true,

      "storeRecentEvents": true,
      "recentEventLimit": 30,

      "memoryRules": {
        "importantEventsCanBecomeMemories": true,
        "emotionalEventsMoreLikelyToBeRemembered": true,
        "repeatedEventsCanBecomeFamiliar": true,
        "ordinaryEventsCanBeForgotten": true
      }
    },

    "autonomy": {
      "enabled": true,

      "rules": {
        "characterCanGenerateInternalEvents": true,
        "characterCanGenerateGoalsFromEvents": true,
        "characterCanReactWithoutUserPrompt": true,
        "worldCanContinueWithoutCharacterInput": true,
        "characterCanMissEvents": true,
        "characterCanIgnoreEvents": true
      }
    }
